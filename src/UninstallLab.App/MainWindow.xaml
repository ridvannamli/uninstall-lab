<Window x:Class="UninstallLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Lab" Height="600" Width="960">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Uninstall Lab" FontSize="22" FontWeight="SemiBold" />

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,8,0,8" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Programlar">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged" />

                    <ListView x:Name="ProgramList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ad" Width="360" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Yayıncı" Width="240" DisplayMemberBinding="{Binding Publisher}" />
                                <GridViewColumn Header="Sürüm" Width="120" DisplayMemberBinding="{Binding Version}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <CheckBox x:Name="QuietBox" Content="Sessiz kaldır" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Kaldır" Margin="4" Padding="16,4" Click="Uninstall_Click" />
                        <Button Content="Seçilenleri toplu kaldır" Margin="4" Padding="16,4" Click="Batch_Click" />
                        <Button Content="Kalıntıları tara" Margin="4" Padding="16,4" Click="Scan_Click" />
                        <Button Content="Kalıntıları temizle" Margin="4" Padding="16,4" Click="Clean_Click" />
                        <Button Content="Son temizliği geri al" Margin="4" Padding="16,4" Click="Undo_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="StoreTab" Header="Mağaza uygulamaları">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="StoreSearchBox" Margin="0,0,0,8" TextChanged="StoreSearchBox_TextChanged" />

                    <ListView x:Name="StoreList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ad" Width="360" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Yayıncı" Width="300" DisplayMemberBinding="{Binding Publisher}" />
                                <GridViewColumn Header="Sürüm" Width="120" DisplayMemberBinding="{Binding Version}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="Seçili uygulamayı kaldır" Margin="4" Padding="16,4" Click="StoreRemove_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <CheckBox x:Name="DryRunBox" Grid.Row="2" IsChecked="True"
                  Content="Sadece göster (hiçbir şeyi kaldırma / silme)" />
    </Grid>
</Window>
