<Window x:Class="UninstallLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Lab" Height="600" Width="960">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Uninstall Lab" FontSize="22" FontWeight="SemiBold" />

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,8,0,8" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Programlar">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged" />

                    <ListView x:Name="ProgramList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ad" Width="360" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Yayıncı" Width="240" DisplayMemberBinding="{Binding Publisher}" />
                                <GridViewColumn Header="Sürüm" Width="120" DisplayMemberBinding="{Binding Version}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <CheckBox x:Name="QuietBox" Content="Sessiz kaldır" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Kaldır" Margin="4" Padding="16,4" Click="Uninstall_Click" />
                        <Button Content="Seçilenleri toplu kaldır" Margin="4" Padding="16,4" Click="Batch_Click" />
                        <Button Content="Kalıntıları tara" Margin="4" Padding="16,4" Click="Scan_Click" />
                        <Button Content="Kalıntıları temizle" Margin="4" Padding="16,4" Click="Clean_Click" />
                        <Button Content="Son temizliği geri al" Margin="4" Padding="16,4" Click="Undo_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="StoreTab" Header="Mağaza uygulamaları">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="StoreSearchBox" Margin="0,0,0,8" TextChanged="StoreSearchBox_TextChanged" />

                    <ListView x:Name="StoreList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ad" Width="360" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Yayıncı" Width="300" DisplayMemberBinding="{Binding Publisher}" />
                                <GridViewColumn Header="Sürüm" Width="120" DisplayMemberBinding="{Binding Version}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="Seçili uygulamayı kaldır" Margin="4" Padding="16,4" Click="StoreRemove_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="StartupTab" Header="Başlangıç programları">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="StartupSearchBox" Margin="0,0,0,8" TextChanged="StartupSearchBox_TextChanged" />

                    <ListView x:Name="StartupList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ad" Width="220" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Durum" Width="70" DisplayMemberBinding="{Binding StateText}" />
                                <GridViewColumn Header="Kaynak" Width="150" DisplayMemberBinding="{Binding SourceText}" />
                                <GridViewColumn Header="Komut" Width="440" DisplayMemberBinding="{Binding Command}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="Devre dışı bırak" Margin="4" Padding="16,4" Click="StartupDisable_Click" />
                        <Button Content="Etkinleştir" Margin="4" Padding="16,4" Click="StartupEnable_Click" />
                        <TextBlock Text="Girdi silinmez; istediğiniz zaman yeniden açılabilir." Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="Gray" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="ExtensionsTab" Header="Tarayıcı eklentileri">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="ExtensionSearchBox" Margin="0,0,0,8" TextChanged="ExtensionSearchBox_TextChanged" />

                    <ListView x:Name="ExtensionList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tarayıcı" Width="80" DisplayMemberBinding="{Binding Browser}" />
                                <GridViewColumn Header="Ad" Width="260" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Sürüm" Width="80" DisplayMemberBinding="{Binding Version}" />
                                <GridViewColumn Header="Durum" Width="60" DisplayMemberBinding="{Binding StateText}" />
                                <GridViewColumn Header="Profil" Width="90" DisplayMemberBinding="{Binding Profile}" />
                                <GridViewColumn Header="Kimlik" Width="300" DisplayMemberBinding="{Binding Id}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="Tarayıcıda eklenti sayfasını aç" Margin="4" Padding="16,4" Click="ExtensionPage_Click" />
                        <Button Content="Klasörü aç" Margin="4" Padding="16,4" Click="ExtensionFolder_Click" />
                        <TextBlock Text="Kaldırmak için tarayıcının kendi eklenti sayfasını kullanın (çalışan tarayıcı ayarlarına dokunulmaz)."
                                   Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <CheckBox x:Name="DryRunBox" Grid.Row="2" IsChecked="True"
                  Content="Sadece göster (hiçbir şeyi kaldırma / silme)" />
    </Grid>
</Window>
