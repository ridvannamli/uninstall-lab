<Window x:Class="UninstallLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Lab" Height="560" Width="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Yüklü programlar" FontSize="22" FontWeight="SemiBold" />
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,8,0,8"
                 TextChanged="SearchBox_TextChanged" />

        <ListView x:Name="ProgramList" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Ad" Width="360" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Yayıncı" Width="240" DisplayMemberBinding="{Binding Publisher}" />
                    <GridViewColumn Header="Sürüm" Width="120" DisplayMemberBinding="{Binding Version}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="DryRunBox" Content="Sadece göster (hiçbir şey kaldırma)"
                      IsChecked="True" VerticalAlignment="Center" />
            <Button Content="Kaldır" Margin="16,0,0,0" Padding="16,4" Click="Uninstall_Click" />
            <Button Content="Kalıntıları tara" Margin="8,0,0,0" Padding="16,4" Click="Scan_Click" />
            <Button Content="Kalıntıları temizle" Margin="8,0,0,0" Padding="16,4" Click="Clean_Click" />
            <Button Content="Son temizliği geri al" Margin="8,0,0,0" Padding="16,4" Click="Undo_Click" />
        </StackPanel>
    </Grid>
</Window>
