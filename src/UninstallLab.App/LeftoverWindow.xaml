<Window x:Class="UninstallLab.App.LeftoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalıntılar" Height="640" Width="980" MinHeight="480" MinWidth="760"
        Icon="Assets/app.ico" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="WarningText" Grid.Row="1" Margin="0,6,0,0" Foreground="DarkRed"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <ListView x:Name="ItemList" Grid.Row="2" Margin="0,8,0,8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="36">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Tür" Width="80" DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn Header="Risk" Width="50" DisplayMemberBinding="{Binding Risk}" />
                    <GridViewColumn Header="Yol" Width="480" DisplayMemberBinding="{Binding Path}" />
                    <GridViewColumn Header="Neden" Width="280" DisplayMemberBinding="{Binding Reason}" />
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Button Content="Tümünü seç" Margin="0,0,8,0" Padding="12,4" Click="SelectAll_Click" />
            <Button Content="Hiçbirini seçme" Margin="0,0,8,0" Padding="12,4" Click="SelectNone_Click" />
            <Button x:Name="CleanButton" Content="Seçilenleri temizle" Margin="0,0,8,0" Padding="16,4" Click="Clean_Click" />
            <Button Content="Kapat" Padding="16,4" Click="Close_Click" />
        </WrapPanel>

        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </Grid>
</Window>
